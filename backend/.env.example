# ── Google PaLM / Gemini ──────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail example: use an App Password (Settings → Security → App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# ── Digest schedule ───────────────────────────────────────────────────────────
# Cron expression for when to send the digest e-mail (default: every hour)
DIGEST_CRON_HOUR=*/1
DIGEST_CRON_MINUTE=0

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── RAG / Chroma ──────────────────────────────────────────────────────────────
# Directory where ChromaDB persists its data
CHROMA_PERSIST_DIR=./chroma_db

# ── Personal E-mail Source ────────────────────────────────────────────────────
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_MAILBOX=INBOX

# ── Telegram Source ───────────────────────────────────────────────────────────
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_SESSION_FILE=./secrets/telegram.session
