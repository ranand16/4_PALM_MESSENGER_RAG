<!-- =============================================================================
     activity_settings.xml — Settings Screen Layout
     
     Defines the UI layout for SettingsActivity. Provides a scrollable vertical
     form containing: app title, description, notification access status/button,
     backend URL input, API key input, save button, and pending sync count.
     Uses Material Design TextInputLayout for styled input fields.
     ============================================================================= -->
<?xml version="1.0" encoding="utf-8"?>
<!-- Root ScrollView: ensures the form is scrollable on small screens -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"> <!-- 24dp padding around the entire scrollable area -->

    <!-- Vertical LinearLayout: stacks all form elements top-to-bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Title: bold 24sp heading displaying the app name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PALM Messenger RAG"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- App Description: brief explanation of what the app does -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Captures phone notifications and sends them to your backend for AI-powered digest emails."
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="24dp" />

        <!-- ===== Notification Access Section ===== -->

        <!-- Status label: shows whether notification access is GRANTED or NOT GRANTED -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification access: checking..."
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Button to open Android system notification access settings -->
        <Button
            android:id="@+id/btn_grant_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Notification Access"
            android:layout_marginBottom="24dp" />

        <!-- ===== Backend URL Input Section ===== -->

        <!-- Material TextInputLayout wrapping the URL input for floating hint label -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Backend URL"
            android:layout_marginBottom="16dp">

            <!-- Text input for the backend server URL; type=textUri for URL keyboard -->
            <!-- Default value points to local network address on port 8000 -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_backend_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:text="http://192.168.1.100:8000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== API Key Input Section ===== -->

        <!-- Material TextInputLayout wrapping the API key input for floating hint label -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API Key"
            android:layout_marginBottom="16dp">

            <!-- Text input for the API key; type=textPassword to mask the input -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== Save Button ===== -->

        <!-- Button to validate and save backend URL and API key to SharedPreferences -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginBottom="24dp" />

        <!-- ===== Pending Sync Count Section ===== -->

        <!-- Label showing the number of unsynced notifications waiting to be uploaded -->
        <TextView
            android:id="@+id/tv_pending_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending sync: ..."
            android:textSize="14sp"
            android:textColor="#888888" />

    </LinearLayout>
</ScrollView>
